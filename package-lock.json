{
  "name": "tsconfig",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "license": "ISC",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@abelspithost/tsconfig": {
      "resolved": "packages/base",
      "link": true
    },
    "node_modules/@abelspithost/tsconfig-node": {
      "resolved": "packages/node",
      "link": true
    },
    "node_modules/@abelspithost/tsconfig-web": {
      "resolved": "packages/web",
      "link": true
    },
    "node_modules/@types/node": {
      "version": "25.6.0",
      "license": "MIT",
      "peer": true,
      "dependencies": {
        "undici-types": "~7.19.0"
      }
    },
    "node_modules/typescript": {
      "version": "6.0.2",
      "license": "Apache-2.0",
      "peer": true,
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "node_modules/undici-types": {
      "version": "7.19.2",
      "license": "MIT",
      "peer": true
    },
    "packages/base": {
      "name": "@abelspithost/tsconfig",
      "version": "0.3.0",
      "license": "ISC",
      "peerDependencies": {
        "typescript": ">=6.0.0"
      }
    },
    "packages/node": {
      "name": "@abelspithost/tsconfig-node",
      "version": "0.1.1",
      "license": "ISC",
      "dependencies": {
        "@abelspithost/tsconfig": "^0.3.0"
      },
      "peerDependencies": {
        "@types/node": ">=24.0.0",
        "typescript": ">=6.0.0"
      }
    },
    "packages/web": {
      "name": "@abelspithost/tsconfig-web",
      "version": "0.0.1",
      "license": "ISC",
      "dependencies": {
        "@abelspithost/tsconfig": "^0.3.0"
      },
      "peerDependencies": {
        "typescript": ">=6.0.0"
      }
    }
  }
}

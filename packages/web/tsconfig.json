{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@abelspithost/tsconfig",
  "compilerOptions": {
    /* Language and Environment */
    "target": "esnext",
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",

    /* Modules */
    "module": "esnext",
    "moduleResolution": "bundler",

    /* Emit */
    "noEmit": true
  },
  "include": [
    "${configDir}/**/*.ts",
    "${configDir}/**/*.tsx",
    "${configDir}/src/**/*.mts",
    "${configDir}/src/**/*.vue",
    "${configDir}/src/**/*.svelte"
  ]
}

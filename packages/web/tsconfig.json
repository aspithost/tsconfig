{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@abelspithost/tsconfig",
  "compilerOptions": {
    /* Language and Environment */
    "target": "esnext",
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",

    /* Modules */
    "module": "esnext",
    "moduleResolution": "bundler",

    /* Emit */
    "noEmit": true,

    /* Paths & Aliases */
    "paths": {
      "@/*": ["${configDir}/src/*"]
    }
  },
  "include": [
    "${configDir}/src/**/*.ts",
    "${configDir}/src/**/*.tsx",
    "${configDir}/src/**/*.vue",
    "${configDir}/src/**/*.svelte"
  ]
}
